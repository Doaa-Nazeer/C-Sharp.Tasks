    #region part1.problem8
    public static class MultiCriteriaSorterDemo
    {
        public static void Run()
        {
            Employee[] employees = {
                new Employee(1, "Zack", 5000),
                new Employee(2, "Alice", 5000),
                new Employee(3, "Bob", 7000)
            };

            SortingTwo<Employee>.Sort(employees, (e1, e2) => {
                if (e1.Salary != e2.Salary)
                    return e1.Salary > e2.Salary;
                return string.Compare(e1.Name, e2.Name, StringComparison.Ordinal) > 0;
            });
        }
    }
