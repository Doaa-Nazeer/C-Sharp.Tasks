    #region part1.problem10
    public static class SortingAlgorithmWithConstraint<T> where T : IComparable<T>, ICloneable
    {
        public static T[] CloneAndSort(T[] array)
        {
            if (array == null) return null;
            T[] clonedArray = new T[array.Length];
            for (int i = 0; i < array.Length; i++)
            {
                clonedArray[i] = (T)array[i].Clone();
            }
            SortingAlgorithm<T>.Sort(clonedArray);
            return clonedArray;
        }
    }
    #endregion

