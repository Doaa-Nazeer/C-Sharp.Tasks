    #region part1.problem6
    public static class AnonymousVsLambdaSortDemo
    {
        public static void Run()
        {
            int[] numbers1 = { 5, 2, 8, 1, 4 };
            int[] numbers2 = { 5, 2, 8, 1, 4 };

            // Anonymous Function
            SortingTwo<int>.Sort(numbers1, delegate (int a, int b) { return a > b; });

