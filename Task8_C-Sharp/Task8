        #region Part 02 - Problem 06 
        public static void SelectionSort(double[] numbers)
        {
            int n = numbers.Length;
            for (int i = 0; i < n - 1; i++)
            {
                int minIdx = i;
                for (int j = i + 1; j < n; j++)
                {
                    if (numbers[j] < numbers[minIdx])
                        minIdx = j;
                }
                double temp = numbers[minIdx];
                numbers[minIdx] = numbers[i];
                numbers[i] = temp;
            }
        }
