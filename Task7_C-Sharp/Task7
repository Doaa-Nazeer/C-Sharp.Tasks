// Question9:
// C# overcomes single class inheritance limits by supporting multiple interface implementations, 
// allowing a class to adhere to multiple distinct contracts.
#endregion

#region Problem10
public abstract class ShapeBase
{
    public virtual void Draw()
    {
        Console.WriteLine("Drawing Shape"); 
    }

    public abstract double CalculateArea(); 
}
public class ShapeRectangle : ShapeBase 
{
    public double Length { get; set; }
    public double Width { get; set; }

    public ShapeRectangle(double length, double width)
    {
        Length = length;
        Width = width;
    }
    public override void Draw() 
    {
        Console.WriteLine("Drawing Rectangle");
    }
    public override double CalculateArea() => Length * Width; 
}

