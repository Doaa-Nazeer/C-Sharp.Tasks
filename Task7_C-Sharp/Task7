// Question2:
// Overloading improves readability and reusability by allowing a single logical name 
// for operations that perform the same concept on different data types/parameter counts.
#endregion

#region Problem03
public class Parent
{
    public int X { get; set; }
    public int Y { get; set; } 
    public Parent(int x, int y)     
    {
        X = x;
        Y = y;
    }
    public virtual int Product() => X * Y; 
    public override string ToString() => $"({X}, {Y})"; 
}

public class Child : Parent
{
    public int Z { get; set; } 
    public Child(int x, int y, int z) : base(x, y) 
    {
        Z = z;
    }
    public override string ToString() => $"({X}, {Y}, {Z})";
}

// Question3:
// Constructor chaining prevents code duplication by ensuring base class initialization 
// happens before child-specific logic runs.
#endregion

#region Problem04
public class ChildNew : Parent
{
    public ChildNew(int x, int y, int z) : base(x, y) { }
    public new int Product() => X * Y * 10;
}

public class ChildOverride : Parent
{
    public ChildOverride(int x, int y, int z) : base(x, y) { }
    public override int Product() => X * Y * 10;
}

// Question4:
// 'override' uses dynamic binding to modify runtime polymorphic behavior, whereas 
// 'new' hides the base method strictly at compile-time when using a child reference.
#endregion

