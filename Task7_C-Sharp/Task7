#region Problem06
public interface IShape
{
    double Area { get; } 
    void Draw(); 
}
public class Rectangle : IShape
{
    public double Width { get; set; }
    public double Height { get; set; }
    public Rectangle(double width, double height)
    {
        Width = width;
        Height = height;
    }
    public double Area => Width * Height; 
    public void Draw() 
    {
        Console.WriteLine($"Drawing Rectangle with Area: {Area}");
    }
}

// Question6:
// Interfaces cannot be instantiated directly because they only represent abstract contracts 
// with no actual object state or implementation memory structure.
#endregion

#region Problem07
public interface IShapeWithDefault
{
    double Area { get; } 
    void Draw(); 

    public void PrintDetails() 
    {
        Console.WriteLine($"Shape Details - Area: {Area}");
    }
}
public class Circle : IShapeWithDefault 
{
    public double Radius { get; set; }

    public Circle(double radius) => Radius = radius;

    public double Area => Math.PI * Radius * Radius;

    public void Draw() => Console.WriteLine("Drawing Circle");
}

